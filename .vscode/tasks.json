{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Django server",
            "type": "shell",
            "command": "python",
            "args": [
                "manage.py",
                "runserver"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
